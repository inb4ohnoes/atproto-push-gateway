# Non-secret deployment settings. Copy to .env on the VPS.
AERY_PUSH_IMAGE=ghcr.io/inb4ohnoes/atproto-push-gateway:REPLACE_WITH_IMMUTABLE_TAG
AERY_APNS_KEY_ID=REPLACE_ME
AERY_APNS_TEAM_ID=REPLACE_ME
AERY_APNS_TOPIC=ninja.probably.Aery
AERY_ORIGIN_VERIFY_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Pin intentionally and review upstream operational announcements before changing.
AERY_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Host ports are loopback-only. The reverse proxy forwards each hostname here.
AERY_PUSH_PRODUCTION_PORT=18081
AERY_PUSH_DEVELOPMENT_PORT=18082
